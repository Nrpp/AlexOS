# AlexOS API
ALEXOS_ENV=development
ALEXOS_API_HOST=0.0.0.0
ALEXOS_API_PORT=8000
# Leave unset for Docker (both docker-compose.yml and .dev.yml already set
# the right path for their own setup - a persisted volume in production,
# a bind-mounted host directory in dev). Only set this yourself if running
# apps/api directly on the host, outside Docker.
# ALEXOS_DATABASE_URL=sqlite+aiosqlite:///./alexos.db
# This is the *dev server's* origin only (Vite's default port, 5173).
# Production doesn't read this value at all - its CORS origin is computed
# directly from ALEXOS_WEB_PORT (below) in docker/docker-compose.yml's
# `environment:` block, deliberately not from this variable, so a change
# here for dev can never silently break production's CORS (see that
# file's comment for why that used to be a real footgun). To reach
# production from more than just http://localhost:<ALEXOS_WEB_PORT>
# (e.g. also http://alexos.local:8090 from other devices), edit
# docker-compose.yml's ALEXOS_CORS_ORIGINS line directly instead.
ALEXOS_CORS_ORIGINS=http://localhost:5173

# AlexOS Web
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
# The host port docker-compose.yml maps to the web container's port 80.
# Default is 8090, not 80, specifically so a fresh install never collides
# with Pi-hole's admin UI (which listens on 80) if you run both on the same
# Pi - see docs/INSTALL_RPI5.md's Troubleshooting section.
ALEXOS_WEB_PORT=8090

# modules/room - Home Assistant (see modules/room/README.md to generate a token)
HA_BASE_URL=
HA_ACCESS_TOKEN=

# modules/alex_assistant - the Alex personal assistant (Proyect-ALEX).
# If it runs on this same Pi, use http://127.0.0.1:8787 - production's
# docker-compose uses host networking, so that reaches the host
# directly (see modules/alex_assistant/README.md for the dev-mode and
# separate-device cases).
ALEX_ASSISTANT_BASE_URL=
ALEX_ASSISTANT_API_TOKEN=

# Gmail (modules/communication), Calendar (modules/calendar), Tasks
# (modules/tasks) - shared Google OAuth client. Run
# scripts/google_oauth_setup.py once to get all three values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# modules/focus - outbound webhook(s) fired on focus start/end so other
# devices can enter Do Not Disturb (see modules/focus/README.md).
# Comma-separated if you have more than one device.
FOCUS_WEBHOOK_URLS=

# modules/media - real Spotify now-playing/playback control. Run
# scripts/spotify_oauth_setup.py once to get all three values (see
# modules/media/README.md for the Spotify Developer Dashboard setup).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
